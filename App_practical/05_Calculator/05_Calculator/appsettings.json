{
  "ConnectionStrings": {
    "DefaultConnection": "Server=mariadb;Port=3306;Database=5-WebCalculatorDb;Uid=root;Pwd=password;"
  },
  "Kafka": {
    "TopicName": "kunev-5-calculations",
    "CallbackUrl": "http://localhost:5005/Calculator/Callback",
    "ProducerSettings": {
      "BootstrapServers": "kafka:9092",
      "MessageTimeoutMs": 10000
    },
    "ConsumerSettings": {
      "BootstrapServers": "kafka:9092",
      "GroupId": "kunev-5-calculator",
      "AutoOffsetReset": "Earliest"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5005"
      }
    }
  }
}
